{
  "recoant": 1,
  "kinds": {
    "user": {
      "attributes": {
        "age": {"type": "number", "sensitive": true},
        "city": {"type": "category"},
        "membership": {"type": "category"}
      }
    },
    "product": {"attributes": {"category": {"type": "category"}}}
  },
  "relations": {"buys": {"subject": "user", "object": "product"}},
  "signals": {
    "view": {"relation": "buys", "weight": 1},
    "purchase": {"relation": "buys", "weight": 5},
    "return": {"relation": "buys", "feedback": "negative", "weight": 5}
  },
  "models": {
    "taste": {"algorithm": "als", "relation": "buys", "params": {"factors": 8, "seed": 1}}
  },
  "segments": {
    "user": {"k": 4, "features": ["taste", "age"], "model": "taste", "seed": 1, "allow_sensitive": true}
  },
  "serving": {
    "for_you": {"model": "taste", "exclude_seen": true, "k": 3},
    "people_like_me": {"model": "taste", "target": "user", "k": 3, "filters": [{"attribute": "segment", "same": true}]}
  }
}
