{
  "recoant": 1,
  "kinds": {
    "user": {
      "attributes": {
        "age": {"type": "number", "sensitive": true},
        "min_age": {"type": "number"},
        "max_age": {"type": "number"},
        "location": {"type": "geo", "sensitive": true},
        "interests": {"type": "set"}
      }
    }
  },
  "relations": {
    "likes": {
      "subject": "user", "object": "user", "half_life": "60d",
      "channels": {"negative": {"no_decay": true}}
    }
  },
  "signals": {
    "view": {"relation": "likes", "weight": 0.5},
    "like": {"relation": "likes", "weight": 5},
    "message": {"relation": "likes", "weight": 8},
    "pass": {"relation": "likes", "feedback": "negative", "weight": 3},
    "block": {"relation": "likes", "feedback": "negative", "weight": 50}
  },
  "models": {
    "attraction": {"algorithm": "als", "relation": "likes", "params": {"factors": 8, "seed": 1}},
    "popular": {"algorithm": "popularity"}
  },
  "matching": {
    "likes": {"mode": "reciprocal", "min_each": 0.05, "exposure_balancing": 0.5}
  },
  "serving": {
    "discover": {
      "model": "attraction", "target": "user", "exclude_seen": true, "fallback": "popular", "k": 5,
      "filters": [
        {"attribute": "age", "within": ["min_age", "max_age"], "mutual": true},
        {"attribute": "location", "max_distance_km": 50}
      ]
    }
  },
  "privacy": {
    "retention": {"likes": "365d"},
    "delete_attributes_with_entity": true
  }
}
