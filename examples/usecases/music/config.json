{
  "recoant": 1,
  "kinds": {
    "user": {},
    "track": {
      "attributes": {
        "genre": {"type": "category"},
        "explicit": {"type": "category"}
      }
    }
  },
  "relations": {
    "listens": {
      "subject": "user", "object": "track", "half_life": "21d",
      "channels": {"negative": {"half_life": "90d"}}
    }
  },
  "signals": {
    "play": {"relation": "listens", "weight": 1, "transform": {"kind": "saturate", "param": 120}},
    "like": {"relation": "listens", "weight": 10},
    "playlist_add": {"relation": "listens", "weight": 6},
    "skip": {"relation": "listens", "feedback": "negative", "weight": 2}
  },
  "models": {
    "mix": {"algorithm": "als", "relation": "listens", "params": {"factors": 5, "seed": 1}},
    "radio": {"algorithm": "item-knn", "relation": "listens", "params": {"neighbors": 20}},
    "charts": {"algorithm": "popularity", "params": {"half_life": "3d"}}
  },
  "serving": {
    "weekly_mix": {"model": "mix", "exclude_seen": true, "fallback": "charts", "k": 5},
    "track_radio": {"model": "radio", "target": "track", "k": 4},
    "charts": {"model": "charts", "target": "track", "k": 5}
  }
}
