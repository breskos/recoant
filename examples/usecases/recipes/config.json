{
  "recoant": 1,
  "half_life": "90d",
  "kinds": {
    "user": {},
    "recipe": {
      "attributes": {
        "cuisine": {"type": "category"},
        "diet": {"type": "set"},
        "minutes": {"type": "number"}
      }
    }
  },
  "relations": {
    "cooks": {"subject": "user", "object": "recipe", "channels": {"rating": {"aggregate": "last"}}}
  },
  "signals": {
    "open": {"relation": "cooks", "weight": 1},
    "save": {"relation": "cooks", "weight": 4},
    "cooked": {"relation": "cooks", "weight": 8},
    "stars": {"relation": "cooks", "feedback": "rating", "scale": [1, 5], "neutral": 3, "weight": 6}
  },
  "models": {
    "taste": {"algorithm": "als", "relation": "cooks", "params": {"factors": 4, "seed": 1}},
    "similar": {"algorithm": "item-knn", "relation": "cooks", "params": {"neighbors": 20, "shrink": 5}},
    "popular": {"algorithm": "popularity"}
  },
  "serving": {
    "for_you": {"model": "taste", "exclude_seen": true, "fallback": "popular", "k": 5},
    "tonight": {
      "model": "taste", "exclude_seen": true, "fallback": "popular", "k": 3,
      "filters": [{"attribute": "minutes", "max": 30}]
    },
    "similar": {"model": "similar", "target": "recipe", "k": 4}
  }
}
